# VentureLab settings. Copy to .env to override the defaults.
# No API keys or secrets are needed: everything runs locally on open-weight models.

# Where the app reaches Ollama (the service name inside docker compose).
OLLAMA_BASE_URL=http://ollama:11434

# Default model, and a smaller fallback for slower machines.
VENTURELAB_MODEL=qwen3:4b
VENTURELAB_FALLBACK_MODEL=qwen3:1.7b

# Seconds to wait for one model response before giving up.
VENTURELAB_LLM_TIMEOUT_S=300

# Context window passed to the model (tokens).
VENTURELAB_NUM_CTX=4096

# How long Ollama keeps a model loaded in memory after a request.
OLLAMA_KEEP_ALIVE=30m

# Host port for the web app (http://localhost:8000).
APP_PORT=8000

# Local state (run records, approval store and the founder approval key) and outputs.
# The founder key file is <state dir>/approvals.sqlite3.founder; keep it private.
VENTURELAB_STATE_DIR=.venturelab
VENTURELAB_OUTPUT_DIR=outputs
VENTURELAB_DECISION_LOG=decision_log.json

# Seconds within which an approval request must be decided and executed.
VENTURELAB_APPROVAL_TTL_S=7200

# At most this many analysis runs may be queued or running at once.
VENTURELAB_MAX_QUEUED_RUNS=3

# Seconds a submitted run waits for the model to finish its first download before it is blocked.
VENTURELAB_MODEL_WAIT_S=900
